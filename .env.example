# --- Supabase (optional in dev — app falls back to sample data) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- WhatsApp ---
# The Baby Mo store number (international format, no plus, no leading 0)
NEXT_PUBLIC_WHATSAPP_NUMBER=6282315971002
WHATSAPP_NUMBER=6282315971002

# --- Fonnte (WhatsApp gateway — Phase 2, optional) ---
FONNTE_API_KEY=your-fonnte-api-key
FONNTE_API_URL=https://api.fonnte.com/send

# --- Admin ---
# Server-only — never expose with NEXT_PUBLIC_. Login is checked by the
# /api/admin/login route, which sets an HttpOnly cookie on success.
# Pick something long + random in production.
ADMIN_PASSCODE=babymo2026
# Optional: separate HMAC secret used to sign the admin session cookie.
# If unset, ADMIN_PASSCODE is used. Set this in production for safety.
ADMIN_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://babymo.id

# --- QRIS image ---
# Optional. If set, the payment page renders this URL as the QR.
# If unset, the page tries /qris.png then /qris.jpg from the public/
# folder before falling back to a decorative placeholder.
NEXT_PUBLIC_QRIS_IMAGE_URL=
